    "from pathlib import Path\n",
    "import warnings\n",
    "import joblib\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.ensemble import GradientBoostingRegressor\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.inspection import permutation_importance\n",
    "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.preprocessing import OneHotEncoder\n",
    "\n",
    "warnings.filterwarnings(\"ignore\", category=FutureWarning)\n",
    "pd.set_option(\"display.max_columns\", 30)\n",
    "\n",
    "# In Google Colab, ask for the CSV upload only when it is not already present.\n",
    "try:\n",
    "    from google.colab import files as colab_files\n",
    "    IN_COLAB = True\n",
    "except ImportError:\n",
    "    IN_COLAB = False\n",
    "\n",
    "DATA_PATH = Path(\"renewable_energy_dataset.csv\")\n",
    "if not DATA_PATH.exists() and IN_COLAB:\n",
    "    print(\"Upload the supplied renewable_energy_dataset.csv file.\")\n",
    "    uploaded = colab_files.upload()\n",
    "    csv_candidates = [name for name in uploaded if name.lower().endswith(\".csv\")]\n",
    "    if not csv_candidates:\n",
    "        raise FileNotFoundError(\"No CSV file was uploaded. Please upload renewable_energy_dataset.csv.\")\n",
    "    # Prefer the expected filename; otherwise use the first uploaded CSV.\n",
    "    selected = next((name for name in csv_candidates if Path(name).name == \"renewable_energy_dataset.csv\"), csv_candidates[0])\n",
    "    DATA_PATH = Path(selected)\n",
    "\n",
    "if not DATA_PATH.exists():\n",
    "    raise FileNotFoundError(\"Place or upload renewable_energy_dataset.csv before continuing.\")\n",
    "\n",
    "CAPACITY_COLUMNS = [\n",
    "    \"Installed - Bio-Mass Power\",\n",
    "    \"Installed - Small Hydro Power\",\n",
    "    \"Installed - Solar Power\",\n",
    "    \"Installed - Wind Power\",\n",
    "    \"Installed - Waste to Energy\",\n",
    "]\n",
    "TARGET = \"Total_Renewable_Capacity\"\n",
    "PREVIOUS_TOTAL = \"Previous Total Capacity\"\n",
    "LAG_COLUMNS = [f\"Previous Year - {col}\" for col in CAPACITY_COLUMNS]\n",
    "PLOTS_DIR = Path(\"plots\")\n",
    "PLOTS_DIR.mkdir(exist_ok=True)\n",
    "\n",
    "raw_df = pd.read_csv(DATA_PATH)\n",
    "source_shape = raw_df.shape\n",
    "print(\"Original dataset shape:\", source_shape)\n",
    "display(raw_df.head())"
   ]
